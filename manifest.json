
{
  "manifest_version": 3,
  "name": "OmniDL",
  "version": "0.1.0",
  "description": "Universal Video Downloader",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "debugger",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OmniDL",
    "default_popup": "ui/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["media-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["media-monitor.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ]
}
